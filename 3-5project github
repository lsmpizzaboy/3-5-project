import streamlit as st
import pandas as pd
import datetime
import time
import google.generativeai as genai
import plotly.express as px

st.set_page_config(page_title="AI 맞춤형 학습 타이머", layout="wide")

# --- [데이터베이스 시뮬레이션 (세션 상태)] ---
# 실제 수파베이스(Supabase) 연동 시 이 부분을 supabase.table().insert() / select() 등으로 교체하면 됩니다.
if "db_users" not in st.session_state:
    st.session_state.db_users = {}
if "db_study_logs" not in st.session_state:
    st.session_state.db_study_logs = []
if "logged_in_user" not in st.session_state:
    st.session_state.logged_in_user = None

# --- [타이머 상태 관리] ---
if "timer_running" not in st.session_state:
    st.session_state.timer_running = False
if "start_time" not in st.session_state:
    st.session_state.start_time = None
if "current_subject" not in st.session_state:
    st.session_state.current_subject = None

# API 키 설정
st.sidebar.title("설정")
api_key = st.sidebar.text_input("Gemini API Key (AI 모드용)", type="password")
if api_key:
    genai.configure(api_key=api_key)

# --- [네비게이션 메뉴] ---
if st.session_state.logged_in_user is None:
    menu = st.sidebar.radio("메뉴", ["로그인", "회원가입"])
else:
    menu = st.sidebar.radio("메뉴", ["타이머 및 공부 기록", "피드백 공간(통계 및 분석)", "로그아웃"])


# ==========================================
# 1. 회원가입 및 로그인
# ==========================================
if menu == "회원가입":
    st.header("👤 회원가입")
    with st.form("signup_form"):
        new_id = st.text_input("아이디")
        new_pw = st.text_input("비밀번호", type="password")
        mode = st.radio("피드백 모드 선택", ["일반 모드 (통계만 제공)", "AI 모드 (통계 + 맞춤형 피드백)"])
        
        st.subheader("과목 및 우선순위 설정")
        st.info("가장 중요하게 생각하는 과목부터 순서대로 적어주세요. (예: 수학, 영어, 국어, 과탐)")
        subjects_input = st.text_input("과목 목록 (쉼표로 구분)")
        
        submitted = st.form_submit_button("가입하기")
        if submitted:
            if new_id in st.session_state.db_users:
                st.error("이미 존재하는 아이디입니다.")
            elif not subjects_input:
                st.error("과목을 하나 이상 입력해주세요.")
            else:
                subjects = [s.strip() for s in subjects_input.split(",") if s.strip()]
                st.session_state.db_users[new_id] = {
                    "pw": new_pw,
                    "mode": mode,
                    "subjects": subjects
                }
                st.success("회원가입 완료! 로그인 탭으로 이동해주세요.")

elif menu == "로그인":
    st.header("🔑 로그인")
    login_id = st.text_input("아이디")
    login_pw = st.text_input("비밀번호", type="password")
    
    if st.button("로그인"):
        user = st.session_state.db_users.get(login_id)
        if user and user["pw"] == login_pw:
            st.session_state.logged_in_user = login_id
            st.success("로그인 성공!")
            st.rerun()
        else:
            st.error("아이디 또는 비밀번호가 틀렸습니다.")

elif menu == "로그아웃":
    st.session_state.logged_in_user = None
    st.session_state.timer_running = False
    st.success("로그아웃 되었습니다.")
    st.rerun()

# ==========================================
# 2. 타이머 및 공부 기록 (로그인 시)
# ==========================================
elif menu == "타이머 및 공부 기록":
    user_id = st.session_state.logged_in_user
    user_data = st.session_state.db_users[user_id]
    
    st.header(f"⏱️ {user_id}님의 공부 타이머")
    
    # 과목 선택
    selected_subject = st.selectbox("공부할 과목 선택", user_data["subjects"], disabled=st.session_state.timer_running)
    
    col1, col2 = st.columns(2)
    with col1:
        st.subheader("타이머 조작")
        if not st.session_state.timer_running:
            if st.button("▶️ 공부 시작"):
                st.session_state.timer_running = True
                st.session_state.start_time = time.time()
                st.session_state.current_subject = selected_subject
                st.rerun()
        else:
            elapsed_time = time.time() - st.session_state.start_time
            mins, secs = divmod(int(elapsed_time), 60)
            hours, mins = divmod(mins, 60)
            st.warning(f"⏳ 진행 중: {hours:02d}:{mins:02d}:{secs:02d} ({st.session_state.current_subject})")
            
            if st.button("⏹️ 공부 종료 및 저장"):
                st.session_state.timer_running = False
                total_minutes = elapsed_time / 60
                
                # 데이터베이스(세션)에 저장
                st.session_state.db_study_logs.append({
                    "user_id": user_id,
                    "date": str(datetime.date.today()),
                    "subject": st.session_state.current_subject,
                    "minutes": round(total_minutes, 2)
                })
                st.success(f"🎉 {st.session_state.current_subject} 과목 {round(total_minutes, 2)}분 기록 완료!")
                st.session_state.start_time = None
                st.session_state.current_subject = None
                st.rerun()
                
    with col2:
        st.subheader("수동 기록 추가")
        st.info("타이머를 깜빡했다면 수동으로 기록하세요.")
        manual_date = st.date_input("날짜 선택")
        manual_mins = st.number_input("공부 시간 (분)", min_value=1)
        if st.button("수동 기록 저장"):
            st.session_state.db_study_logs.append({
                "user_id": user_id,
                "date": str(manual_date),
                "subject": selected_subject,
                "minutes": manual_mins
            })
            st.success("저장되었습니다.")

# ==========================================
# 3. 피드백 공간 (통계 및 AI 분석)
# ==========================================
elif menu == "피드백 공간(통계 및 분석)":
    user_id = st.session_state.logged_in_user
    user_data = st.session_state.db_users[user_id]
    
    st.header("📊 피드백 공간")
    st.write(f"현재 설정된 모드: **{user_data['mode']}**")
    st.write(f"나의 과목 우선순위 (1순위부터): **{', '.join(user_data['subjects'])}**")
    st.markdown("---")
    
    # 사용자 데이터 필터링
    user_logs = [log for log in st.session_state.db_study_logs if log["user_id"] == user_id]
    
    if not user_logs:
        st.warning("아직 공부 기록이 없습니다. 타이머를 사용해 기록을 남겨보세요!")
    else:
        df = pd.DataFrame(user_logs)
        
        # 1. 통계 시각화 (공통)
        st.subheader("📈 내 공부 통계")
        col1, col2 = st.columns(2)
        
        # 과목별 총 시간 계산
        subject_totals = df.groupby('subject')['minutes'].sum().reset_index()
        
        with col1:
            fig_pie = px.pie(subject_totals, values='minutes', names='subject', title='과목별 공부 비율 (원 그래프)')
            st.plotly_chart(fig_pie, use_container_width=True)
            
        with col2:
            fig_bar = px.bar(subject_totals, x='subject', y='minutes', title='과목별 누적 공부 시간 (막대 그래프)', color='subject')
            st.plotly_chart(fig_bar, use_container_width=True)
            
        # 2. AI 피드백 제공 (AI 모드일 경우)
        if "AI" in user_data["mode"]:
            st.markdown("---")
            st.subheader("🤖 Gemini 맞춤형 피드백")
            
            if not api_key:
                st.error("좌측 사이드바에 Gemini API Key를 입력해야 AI 피드백을 받을 수 있습니다.")
            else:
                if st.button("AI 피드백 생성하기"):
                    with st.spinner("데이터를 분석하고 피드백을 작성 중입니다..."):
                        try:
                            # 프롬프트에 제공할 데이터 정리
                            priorities_str = ", ".join(user_data["subjects"])
                            study_data_str = subject_totals.to_string(index=False)
                            
                            prompt = f"""
                            너는 학생의 공부 데이터를 분석해주는 날카롭고 친절한 AI 코치야.
                            
                            [학생 정보 및 데이터]
                            - 학생이 설정한 과목별 우선순위(앞일수록 중요): {priorities_str}
                            - 현재까지 과목별 누적 공부 시간(분): 
                            {study_data_str}
                            
                            [요구사항]
                            1. 학생이 설정한 '우선순위'와 '실제 공부 시간'을 비교 분석해줘.
                            2. 중요도가 높은데 시간이 부족한 과목이 있는지(편식), 우선순위가 낮은데 시간을 너무 많이 쏟은 과목이 있는지 파악해줘.
                            3. 앞으로 어떤 과목을 늘리고 어떤 과목을 줄여야 할지 구체적인 피드백을 제공해줘.
                            """
                            
                            model = genai.GenerativeModel('gemini-2.5-flash')
                            response = model.generate_content(prompt)
                            
                            st.info(response.text)
                        except Exception as e:
                            st.error(f"AI 호출 중 오류가 발생했습니다: {e}")
